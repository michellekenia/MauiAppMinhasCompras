<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.RelatorioGasto"
             Title="Relatório por Categoria">
    <VerticalStackLayout Spacing="10" Padding="15">
        <Label Text="Total Gasto por Categoria"
               FontSize="Title"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <CollectionView x:Name="ListaRelatorio">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0"
                               Text="{Binding Categoria}"
                               FontSize="Medium"
                               FontAttributes="Bold" />
                        <Label Grid.Column="1"
                               Text="{Binding TotalGasto, StringFormat='{0:C2}'}"
                               FontSize="Medium"
                               FontAttributes="Bold"
                               TextColor="Green"
                               HorizontalOptions="End" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>